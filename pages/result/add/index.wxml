<!--pages/publish/index.wxml-->
<view class='container'>
  <form bindsubmit='saveArticle'>
    <view class="weui-cells weui-cells_after-title">

      <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label">成绩</view>
        </view>
        <view class="weui-cell__bd">
          <view style='display:flex; align-items:center'>
            <input class="weui-input" name="score" placeholder="成绩" />
          </view>
        </view>
      </view>

      <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label">学生</view>
        </view>
        <view class="weui-cell__bd">
          <picker bindchange="bindStudentChange" value="{{studentIndex}}" range="{{studentList}}" range-key="realName">
            <view class="weui-select weui-select_in-select-after">{{studentList[studentIndex].realName}}</view>
          </picker>
        </view>
      </view>

      <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label">课程</view>
        </view>
        <view class="weui-cell__bd">
          <picker bindchange="bindCourseChange" value="{{courseIndex}}" range="{{courseList}}" range-key="courseName">
            <view class="weui-select weui-select_in-select-after">{{courseList[courseIndex].courseName}}</view>
          </picker>
        </view>
      </view>

      <view class="weui-cell" hidden="true">
        <view class="weui-cell__bd">
          <textarea name="describe" class="weui-textarea" placeholder="请输入描述" style="height: 5.3em" />
        </view>
      </view>
    </view>

    <view class="weui-btn-area">
      <button type="primary" class="weui-btn" form-type="submit">保存</button>
    </view>
  </form>

</view>