/* pages/courseCopy/list/index.wxss */
.contentDiv {
  width: 100%;
  height: 81px;
  margin-top: 8px;
  margin-left: 20px;
  margin-right: 20px;
}

.contentNextDiv {
  /* Rectangle 557 */
  position: relative;
  width: calc(100% - 40px);
  height: 81px;
  background: rgb(255, 255, 255);
  box-shadow: 12px 26px 50px rgba(90, 108, 234, 0.07);
  border-radius: 22px;
}

.picDiv {
  /* Photo Profile */
  position: absolute;
  width: 62px;
  height: 62px;
  margin-top: 8px;
  margin-bottom: 10px;
  margin-left: 9px;
  border-radius: 16px;
}

.nameLable {
  /* Sample Name */
  position: absolute;
  width: calc(100% - 105.5px);
  height: 20px;
  color: rgb(9, 4, 27);
  font-size: 15px;
  font-weight: 400;
  line-height: 1.3102272748947144;
  letter-spacing: 0%;
  text-align: left;
  margin-left: 87.5px;
  margin-top: 20px;
  margin-bottom: 41px;
  text-overflow :ellipsis; /*让截断的文字显示为点点。还有一个值是clip意截断不显示点点*/
	white-space :nowrap; /*让文字不换行*/
  overflow : hidden; /*超出要隐藏*/
}

.addressLable {
  /* Chat Notification */
  position: absolute;
  width: calc(100% - 177.5px);
  height: 16px;
  opacity: 0.3;
  color: rgb(59, 59, 59);
  font-size: 14px;
  font-weight: 400;
  line-height: 21px;
  letter-spacing: 0.5px;
  text-align: left;
  margin-left: 87.5px;
  margin-top: 48px;
  margin-bottom: 19px;
  display: inline;
  text-overflow :ellipsis; /*让截断的文字显示为点点。还有一个值是clip意截断不显示点点*/
	white-space :nowrap; /*让文字不换行*/
  overflow : hidden; /*超出要隐藏*/
}

.timeDiv {
  /* Time */
  position: absolute;
  width: 90px;
  height: 14px;
  margin-right: 1px;
  margin-top: 48px;
  margin-left: calc(100% - 90px);
  margin-bottom: 19px;
  opacity: 0.3;
  color: rgb(59, 59, 59);
  font-size: 14px;
  font-weight: 400;
  line-height: 21px;
  letter-spacing: 0.5px;
  text-align: left;
}

.lineDiv {
  /* 箭头 */
  position: absolute;
  width: 12px;
  height: 24px;
  margin-right: 26px;
  margin-top: 20px;
  margin-left: calc(100% - 38px);
  margin-bottom: 41px;
}