/* pages/courseCopy/add/index.wxss */
.mycontainer {
  background-color: rgb(232, 243, 255);
  grid-template-columns: auto;
  grid-template-rows: 40% 50% 10%;
  align-items: center;
  padding: 8px;
  height: 100vh;

  /* 16/Regular */
  color: rgb(29, 33, 41);
  font-family: PingFang SC;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.399999976158142;
  letter-spacing: 0%;
  text-align: left;
}

.formDiv {
  /* 自动布局 */
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding: 1px;

  /* Inside Auto Layout */
  flex: none;
  order: 0;
  flex-grow: 0;
}

.inputDiv {
  background-color: #FFFFFF;
  /* 自动布局 */
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  padding: 3px;
  margin-top: 1px;
  width: 100%;
  height: 50px;
  /* Inside Auto Layout */
  flex: none;
  order: 0;
  flex-grow: 0;
}

.showFile {
  width: 100%;
  padding: 3px;
}
.btn {
  border: none;
  height: 32px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 14px;
  margin: 4px 2px;
  cursor: pointer;
  border-radius: 100px;
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
}
.btnSelect {
  width: 120px;
  color: white;
  background-color: #4CAF50;
  border: #4CAF50;
  margin-left: 10px;
}

.delBtn {
  width: 90px;
  align-items: center;
  background-color: white;
  border: none;
}
.button-sp-area{
  margin: 0 auto;
  width: 60%;
  margin-top: 5px;
}
.tips {
  position: static;
  width: 16px;
  height: 16px;
}
@font-face {
  font-family: 'iconfont';
  src: url('data:font/woff2;charset=utf-8;base64,') format('woff2'),
      url('data:font/woff;charset=utf-8;base64,') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
.lableStycle {
  text-overflow :ellipsis; /*让截断的文字显示为点点。还有一个值是clip意截断不显示点点*/
	white-space :nowrap; /*让文字不换行*/
  overflow : hidden; /*超出要隐藏*/
}
.lableTitle{
  width: 101px;
}
.iconfont {
  font-family: "iconfont" !important;
  font-size: 24px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.icon-shanchu:before {
  content: "\f012d";
}